{
  "name": "charter-spec",
  "version": "0.1.0",
  "private": true,
  "description": "The charter contract: schema, validator, validator tests, and the public site with its status check",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./scripts/*": "./scripts/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "packages",
    "scripts",
    "website"
  ],
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:site": "node scripts/verify-site-status.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
